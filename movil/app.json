{
  "expo": {
    "name": "Caravana",
    "slug": "caravana",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caravana",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.caravana.mobile",
      "infoPlist": {
        "UIBackgroundModes": ["location", "audio"]
      }
    },
    "android": {
      "package": "app.caravana.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#06080B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#06080B"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Caravana necesita tu ubicación para registrar tus rutas automáticamente y compartirla solo dentro de una party.",
          "locationWhenInUsePermission": "Caravana usa tu ubicación para mostrar tu posición en el mapa y registrar tus rutas.",
          "motionUsagePermission": "Caravana detecta si estás conduciendo para iniciar el registro de tu viaje automáticamente.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Caravana usa la cámara para escanear el QR de perfiles, coches y parties.",
          "microphonePermission": "Caravana usa el micrófono para el walkie-talkie de las parties.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5A1F",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Caravana accede a tus fotos para la foto de perfil, el garaje y las publicaciones.",
          "cameraPermission": "Caravana usa la cámara para la foto de perfil y el garaje."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
