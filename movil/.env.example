# Variables públicas de Expo (se incluyen en el bundle; nunca pongas secretos aquí).

# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Base pública para los enlaces de los QR (perfil, coche y party).
EXPO_PUBLIC_WEB_URL=https://caravana.app

# MapTiler → https://cloud.maptiler.com/account/keys/
# Clave pública para estilos y tiles; si queda vacía se usa OpenFreeMap.
EXPO_PUBLIC_MAPTILER_KEY=

# GraphHopper (rutas por carretera). Usa servidor propio o API cloud, no ambos.
# Servidor propio: http://TU_IP_LAN:8989 (en móvil no uses localhost).
EXPO_PUBLIC_GRAPHHOPPER_URL=
# API cloud: crea una API key en graphhopper.com
EXPO_PUBLIC_GRAPHHOPPER_API_KEY=
EXPO_PUBLIC_GRAPHHOPPER_PROFILE=car

# LiveKit: URL pública del servidor; la API key/secret solo vive en la Edge Function.
EXPO_PUBLIC_LIVEKIT_URL=

# Entorno de distribución. Usa "production" en el build de tiendas para evitar
# caer silenciosamente al modo demo cuando falte Supabase.
EXPO_PUBLIC_APP_ENV=development
